# syntax=docker/dockerfile:1.7

# Runtime image for vago-bot (linux/arm64)
# This image does not compile Rust code; it only copies a prebuilt binary.
FROM --platform=linux/arm64 docker.io/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git openssh-client \
    && rm -rf /var/lib/apt/lists/*

# GitHub 官方 SSH host key（https://api.github.com/meta），push 時嚴格比對
COPY known_hosts /etc/ssh/ssh_known_hosts

ARG BIN_PATH=container-bin/vago-bot
ARG BIN_NAME=vago-bot

WORKDIR /app
COPY ${BIN_PATH} /usr/local/bin/${BIN_NAME}
RUN chmod +x /usr/local/bin/${BIN_NAME}

ENTRYPOINT ["/usr/local/bin/vago-bot"]
